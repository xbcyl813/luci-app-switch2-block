msgid "Switch 2 Blocker"
msgstr "Switch 2 联网伪装"

msgid "Nintendo Switch 2 Connection Spoof & Update Blocker"
msgstr "Nintendo Switch 2 联网伪装与系统更新阻断"

msgid "Emulate Nintendo connection test responses via isolated dnsmasq and uHTTPd instances so Switch 2 / Switch 1 can pass network checks without external internet access."
msgstr "通过独立 dnsmasq 实例与 uHTTPd 伪装响应，使 Switch 2 / Switch 1 在完全断绝外网更新的情况下通过局域网连接测试。"

msgid "Note:"
msgstr "提示："

msgid "If proxy plugins (SSR Plus+ / PassWall / OpenClash) are enabled, add the Nintendo test domain and Spoof Helper IP to the bypass whitelist to prevent traffic hijacking."
msgstr "若路由器启用了 SSR Plus+ / PassWall / OpenClash 等代理插件，请务必将「任天堂联网测试域名」及「Switch 专用伪装辅助 IP」加入不走代理的白名单，防止流量被代理插件劫持。"

msgid "Basic Network Isolation Settings"
msgstr "基础网络隔离设置"

msgid "Current Firewall Architecture"
msgstr "当前固件防火墙架构"

msgid "fw3 (iptables) - Auto-uses /etc/firewall.user"
msgstr "fw3 (iptables) - 自动使用 /etc/firewall.user"

msgid "Enable Spoof & Update Blocker"
msgstr "启用伪装与断网保护"

msgid "Automatically configure helper interface, isolate dnsmasq/uHTTPd listeners, and inject firewall blocking rules; restores original settings cleanly when disabled."
msgstr "开启后将自动配置辅助接口、分离 dnsmasq/uHTTPd 监听并注入防火墙阻断规则；关闭后自动无损还原默认网络配置。"

msgid "Enable Force DHCP"
msgstr "开启强制 DHCP"

msgid "Recommended for bypass/secondary gateway mode. Forces main_dns to handle LAN DHCP (sets dhcp.lan.force=1) so the main router will not assign wrong DNS."
msgstr "旁路由模式推荐开启。强制由本路由器的 main_dns 接管局域网 DHCP 分配（即设置 dhcp.lan.force=1），防止主路由抢先回应导致 Switch 2 获取到错误的 DNS。"

msgid "fw4 Firewall Rule Mode"
msgstr "fw4 防火墙规则写入方式"

msgid "Official OpenWrt 22.03+ recommends Native Rule Directory; custom firmware like LEDE recommends Custom Rules File."
msgstr "官方原版 OpenWrt 22.03+ 推荐选择「原生规则目录」；LEDE 等带自定义规则页面的定制固件推荐选择「自定义规则文件」。"

msgid "Write to /etc/nftables.d/ native directory (Official OpenWrt)"
msgstr "写入 /etc/nftables.d/ 原生规则目录（官方原版通用）"

msgid "Write to /etc/firewall.user custom script (Recommended for LEDE)"
msgstr "写入 /etc/firewall.user 自定义规则文件（LEDE 固件默认推荐）"

msgid "Router Main LAN IP"
msgstr "路由器主 LAN IP"

msgid "IP address for main dnsmasq and LuCI web management (auto-detected from LAN interface)."
msgstr "主 dnsmasq 与后台管理界面监听的 IP 地址（自动探测当前 LAN 口 IP）。"

msgid "Switch Spoof Helper IP"
msgstr "Switch 专用伪装辅助 IP"

msgid "Virtual alias IP created on br-lan. Must be in the same subnet as Main LAN IP and not identical."
msgstr "在 br-lan 上创建的独立虚拟接口 IP，必须与主 LAN IP 在同一网段且不能相同。"

msgid "Spoof Helper IP cannot be identical to Router Main LAN IP!"
msgstr "伪装辅助 IP 不能与路由器主 LAN IP 相同！"

msgid "Spoof Helper IP must be in the same /24 subnet as Main LAN IP (e.g., %s.254)!"
msgstr "伪装辅助 IP 必须与主 LAN IP 处于同一 /24 网段（如 %s.254）！"

msgid "Nintendo Connection Test Domains"
msgstr "任天堂联网测试域名列表"

msgid "Supports multiple domains (e.g. Switch 2: ctest.p01.ctest.srv.nintendo.net, Switch 1: ctest.cdn.nintendo.net)."
msgstr "支持添加多个拦截域名（例如 Switch 2 使用 ctest.p01.ctest.srv.nintendo.net，Switch 1 使用 ctest.cdn.nintendo.net）。"

msgid "Service Connectivity Self-Test"
msgstr "服务连通性自检"

msgid "After clicking Save & Apply, click here to verify DNS hijacking, HTTP 2-byte response, port 80 usage, and firewall rules."
msgstr "保存并应用后，点击此按钮调用 test.sh 验证 DNS 解析、HTTP 2 字节响应、80 端口占用及防火墙状态。"

msgid "Run Connectivity Self-Test"
msgstr "立即测试伪装服务"

msgid "Controlled Devices (MAC-based DNS & Firewall Isolation)"
msgstr "受控主机列表 (MAC 精准下发与防火墙兜底)"

msgid "Listed devices set to Automatic (DHCP) will receive the dedicated spoof DNS and optional WAN isolation. If this list is left empty while enabled, the plugin runs in Manual DNS Mode: you must manually set a static IP and use the Spoof Helper IP as DNS on your Switch (note: firewall-level MAC blocking will not apply)."
msgstr "列出的设备在 Wi-Fi 设置为「自动获取 (DHCP)」时，将自动分配专属伪装 DNS，并可选通过防火墙彻底封禁外网访问。若启用插件但将此列表留空，系统将运行在「纯手动 DNS 模式」：您需要在 Switch 上手动设置静态 IP 并将 DNS 填为伪装辅助 IP（注意：未填写 MAC 时防火墙级断外网兜底不会生效）。"

msgid "No MAC address configured. Running in Manual DNS Mode: please manually assign a static IP on your Switch and set its DNS to %s. Note that firewall-level WAN blocking is inactive without a MAC address."
msgstr "未配置受控设备 MAC 地址，已进入「纯手动 DNS 模式」：请在 Switch 上手动指定可用静态 IP，并将 DNS 设置为 %s。请注意：未登记 MAC 时，路由器防火墙层的硬阻断规则不会生效。"

msgid "Device Name"
msgstr "设备备注"

msgid "MAC Address"
msgstr "MAC 地址"

msgid "Static IP (Optional)"
msgstr "分配静态 IP (可选)"

msgid "Leave blank for dynamic DHCP assignment with dedicated spoof DNS."
msgstr "留空则由路由器自动分配动态 IP，并同样下发专属伪装 DNS。"

msgid "Auto-assign (e.g., %s.x)"
msgstr "留空自动分配 (如 %s.x)"

msgid "Auto-assign"
msgstr "留空自动分配"

msgid "Static IP cannot be identical to Main LAN IP or Spoof Helper IP!"
msgstr "静态 IP 不能与路由器主 IP 或伪装辅助 IP 相同！"

msgid "Static IP must be in the same subnet as Main LAN IP (%s.x)!"
msgstr "静态 IP 必须与路由器主 LAN IP 处于同一网段（%s.x）！"

msgid "Block WAN via Firewall"
msgstr "防火墙彻底断外网"

msgid "Inject firewall rules to block IPv6 ICMPv6 and all IPv4/IPv6 WAN forwarding for this MAC to prevent hardcoded IP leaks."
msgstr "注入防火墙规则拦截该 MAC 的 IPv6 ICMPv6 寻址及所有 IPv4/IPv6 外网转发流量，防止后台硬编码 IP 偷跑更新。"

msgid "Spoof & Blocker is currently disabled. Please enable it and click Save & Apply first."
msgstr "当前未启用「启用伪装与断网保护」，请先勾选并点击「保存并应用」后再执行自检。"

msgid "Unsaved changes detected on this page or device list. Please click Save & Apply before running self-test!"
msgstr "检测到当前页面参数或受控设备列表已修改但尚未生效，请先点击底部的「保存并应用」后再进行自检！"

msgid "Spoof Helper IP is empty. Please enter an IP and click Save & Apply."
msgstr "伪装辅助 IP 为空，请先填写并点击「保存并应用」。"

msgid "Running Connectivity Self-Test..."
msgstr "正在执行连通性伪装自检..."

msgid "Calling test.sh to verify DNS hijacking, uHTTPd 2-byte response, port 80 usage, and firewall rules..."
msgstr "正在调用 test.sh 验证 DNS 劫持、uHTTPd 2 字节响应、80 端口占用及防火墙规则..."

msgid "Normal (All %d domains resolved to %s)"
msgstr "正常 (全部 %d 个域名均已解析至 %s)"

msgid "Abnormal (Target IP not matched; check global DNS redirect or proxy hijacking)"
msgstr "异常 (未命中目标 IP，请检查全局 DNS 重定向或代理劫持)"

msgid "Normal (Returned 200 OK with exact 2-byte body \"ok\")"
msgstr "正常 (返回 200 OK 且正文精确为 2 字节 \"ok\")"

msgid "Abnormal (Unexpected status or body length; current bytes: %s)"
msgstr "异常 (响应状态或正文字节不符，当前字节数: %s)"

msgid "Abnormal: No listener detected on %s:80 (uHTTPd helper instance not running)"
msgstr "异常：未检测到 %s:80 的监听进程 (uHTTPd 辅助实例未启动)"

msgid "Normal (Exclusively bound by uHTTPd on %s:80, no port conflict)"
msgstr "正常 (已由 uHTTPd 独占监听 %s:80，无端口冲突)"

msgid "Other Web Service"
msgstr "其他 Web 服务"

msgid "Conflict: Port 80 is globally occupied by \"%s\"! Please bind it only to Main LAN IP (%s:80)"
msgstr "冲突：80 端口被「%s」全局占用！请将其改为仅监听主 LAN IP (%s:80)"

msgid "Skipped (No device enabled for WAN blocking)"
msgstr "已跳过 (受控列表未启用断外网设备)"

msgid "Written to %s and active in kernel firewall (%d rules)"
msgstr "已写入 %s 且内核防火墙已实时生效 (共 %d 条规则)"

msgid "Written to %s, but not loaded by kernel! Please switch \"fw4 Firewall Rule Mode\" to \"/etc/firewall.user\" and Save & Apply."
msgstr "规则已写入 %s，但当前固件内核未自动加载！请在「fw4 防火墙规则写入方式」中切换为「写入 /etc/firewall.user 自定义规则文件」后重新保存并应用。"

msgid "Written to %s, but not loaded by kernel! Please switch \"fw4 Firewall Rule Mode\" to \"/etc/nftables.d/\" and Save & Apply."
msgstr "规则已写入 %s，但内核防火墙未加载！请在「fw4 防火墙规则写入方式」中切换为「写入 /etc/nftables.d/ 原生规则目录」后重新保存并应用。"

msgid "Written to %s, but not loaded by kernel! Please check if the firewall service is running properly."
msgstr "规则已写入 %s，但内核防火墙未加载！请检查系统 firewall 服务是否正常运行。"

msgid "No blocking rules found in %s (Please ensure Save & Apply was clicked)"
msgstr "未在 %s 检测到阻断规则 (请确认已点击「保存并应用」)"

msgid "Self-Test Results"
msgstr "自检结果"

msgid "1. DNS Hijacking Status:"
msgstr "1. DNS 劫持状态："

msgid "2. HTTP Spoof Status:"
msgstr "2. HTTP 伪装状态："

msgid "3. Port 80 Usage Check:"
msgstr "3. 80 端口占用检查："

msgid "4. Firewall Blocking Rules:"
msgstr "4. 防火墙阻断规则状态："

msgid "No output"
msgstr "无输出"

msgid "No port 80 listener records detected"
msgstr "未检测到相关 80 端口监听记录"

msgid "No active Switch 2 blocking rules found in kernel firewall"
msgstr "内核防火墙中暂无生效的 Switch 2 阻断规则"

msgid "Close"
msgstr "关闭"

msgid "Self-test execution failed: "
msgstr "检测执行失败: "

msgid "Default example MAC (11:22:33:44:55:66) is still in the device list! Please replace it with your real Switch MAC address before saving."
msgstr "受控主机列表中仍存在默认示例 MAC（11:22:33:44:55:66）！请先将其修改为您的 Switch 真实 MAC 地址后再保存并应用。"

msgid "Configuration Error"
msgstr "配置错误"

msgid "Manual DNS Mode Notice"
msgstr "纯手动 DNS 模式提示"

msgid "Cancel"
msgstr "取消"

msgid "Confirm & Save"
msgstr "确认并保存"

msgid "Normal (All %d domains resolved to %s), IPv6 DNS resolution blocked"
msgstr "正常 (全部 %d 个域名均已解析至 %s)，ipv6域名解析已禁止。"

msgid "Normal (All %d domains resolved to %s), but IPv6 DNS resolution is NOT blocked"
msgstr "正常 (全部 %d 个域名均已解析至 %s)，但 ipv6域名解析未禁止"
